table dim_date
	lineageTag: 5094c592-94d0-4571-8964-02d19eded618
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: a4d43030-ad15-4ae5-936b-7510c645a93a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: ee6a110e-1047-4a19-ab5c-fdefe6d44f63
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: a35ef6ac-7ca3-445c-b139-819236f0f8d4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 8f22fb2d-bfd8-4550-9498-5f31fa6236a9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month No'

		annotation SummarizationSetBy = Automatic

	column Month-Year
		dataType: string
		lineageTag: 28f9ad56-85c4-4585-9ba1-8d4bca60a9fc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month-Year]
		sortByColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	column YearMonth
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a5e1bdd5-723e-4b53-8fca-e1d81fcc8675
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

		annotation SummarizationSetBy = Automatic

	/// TRUE for dates up to the end of the last month with registration data.
	column HasActuals = dim_date[Date] <= EOMONTH ( MAX ( national_monthly_long[month] ), 0 )
		dataType: boolean
		lineageTag: afc8f0da-c334-4610-a1ef-4bcce7c6bc40
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source =
				ADDCOLUMNS (
					CALENDAR ( DATE ( 2006, 1, 1 ), DATE ( 2028, 12, 31 ) ),
					"Year", YEAR ( [Date] ),
					"Month No", MONTH ( [Date] ),
					"Month", FORMAT ( [Date], "MMM" ),
					"Month-Year", FORMAT ( [Date], "MMM yyyy" ),
					"YearMonth", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)

